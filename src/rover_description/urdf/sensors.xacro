<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================== LiDAR ======================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- LiDAR mount: 0.14 m above base_link (x offset slightly forward or centered) -->
    <origin xyz="0.05 0 0.14" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.15" r="0.035" h="0.04"/>
  </link>

  <!-- ======================== Camera ======================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Camera mount: 0.18 m above base_link, front edge (x=0.17), pitched -10 deg (downwards) -->
    <!-- -10 deg = -0.174533 rad in pitch (y-axis) -->
    <origin xyz="0.17 0 0.18" rpy="0 0.174533 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.08 0.025"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.08 0.025"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.05" x="0.025" y="0.08" z="0.025"/>
  </link>

  <!-- Camera Optical Frame (REP-103: z forward, x right, y down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}"/>
  </joint>

  <link name="camera_optical_frame"/>

  <!-- ======================== IMU ======================== -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="imu_green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.01" x="0.02" y="0.02" z="0.005"/>
  </link>

</robot>
