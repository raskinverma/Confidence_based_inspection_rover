<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions & Masses -->
  <xacro:property name="chassis_length" value="0.35"/>
  <xacro:property name="chassis_width" value="0.25"/>
  <xacro:property name="chassis_height" value="0.08"/>
  <xacro:property name="chassis_mass" value="2.5"/>

  <!-- Wheel specifications -->
  <xacro:property name="wheel_radius" value="0.0425"/>
  <xacro:property name="wheel_width" value="0.030"/>
  <xacro:property name="wheel_separation" value="0.27"/> <!-- Track width (y-axis separation) -->
  <xacro:property name="wheelbase" value="0.20"/>        <!-- Longitudinal axle separation (x-axis) -->
  <xacro:property name="wheel_mass" value="0.20"/>

  <!-- base_footprint is on the ground plane directly below base_link -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link (origin at wheel axle height) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <!-- ==================== Wheel Macro ==================== -->
  <xacro:macro name="wheel" params="prefix side_sign x_pos rpy_rot axis_z">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_pos} ${side_sign * wheel_separation / 2.0} 0" rpy="${rpy_rot} 0 0"/>
      <axis xyz="0 0 ${axis_z}"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>
  </xacro:macro>

  <!-- 4-Wheel Skid-Steer Layout -->
  <!-- Left side (side_sign = 1, rpy = -pi/2, axis = 1) -->
  <xacro:wheel prefix="front_left" side_sign="1"  x_pos="${wheelbase / 2.0}"  rpy_rot="-${pi/2}" axis_z="1"/>
  <xacro:wheel prefix="rear_left"  side_sign="1"  x_pos="-${wheelbase / 2.0}" rpy_rot="-${pi/2}" axis_z="1"/>

  <!-- Right side (side_sign = -1, rpy = pi/2, axis = -1) -->
  <xacro:wheel prefix="front_right" side_sign="-1" x_pos="${wheelbase / 2.0}"  rpy_rot="${pi/2}"  axis_z="-1"/>
  <xacro:wheel prefix="rear_right"  side_sign="-1" x_pos="-${wheelbase / 2.0}" rpy_rot="${pi/2}"  axis_z="-1"/>

</robot>
