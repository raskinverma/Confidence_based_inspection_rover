  <maintainer email="vermaraskin@gmail.com">raskin</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rover_description</exec_depend>
  <exec_depend>rover_gazebo</exec_depend>
