<?xml version="1.0"?>
<package format="3">
  <name>rover_perception</name>
  <version>0.1.0</version>
  <description>Defect detection, pose projection, and logging for the inspection rover</description>
  <maintainer email="vermaraskin@gmail.com">raskin</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>tf2_ros</depend>
  <depend>rover_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
